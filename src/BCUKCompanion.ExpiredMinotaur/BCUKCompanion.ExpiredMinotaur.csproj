<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BCUKCompanion.ExpiredMinotaur</RootNamespace>
    <AssemblyName>BCUKCompanion.ExpiredMinotaur</AssemblyName>
  </PropertyGroup>

  <!--
    UseLocalCore is off unless a local, untracked .csproj.user file turns it on (see
    BCUKCompanion.ExpiredMinotaur.csproj.user, which is *.user-gitignored). This keeps the
    sibling-checkout dev wiring out of source control entirely, so CI and every other clone
    always build against the published, pinned PackageReference versions below.
  -->
  <PropertyGroup>
    <UseLocalCore Condition="'$(UseLocalCore)' == ''">false</UseLocalCore>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalCore)' != 'true'">
    <PackageReference Include="BCUKCompanion.Core" Version="0.6.0" />
    <PackageReference Include="BCUKCompanion.TrayApp.Shell" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalCore)' == 'true'">
    <ProjectReference Include="..\..\..\BCUK-Companion-Core\src\BCUKCompanion.Core\BCUKCompanion.Core.csproj" />
    <ProjectReference Include="..\..\..\BCUK-Companion-Core\src\BCUKCompanion.TrayApp.Shell\BCUKCompanion.TrayApp.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildProjectFullPath).user" Condition="Exists('$(MSBuildProjectFullPath).user')" />

</Project>
